local ffOriginalColors, ffConnection = {}, nil
local function FF_Save(char)
    ffOriginalColors[char] = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then ffOriginalColors[char][part] = { Color = part.Color, Material = part.Material } end
    end
end
local function FF_Apply(char)
    FF_Save(char)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Color = Vars.FFColor; part.Material = Enum.Material.ForceField end
    end
end
local function FF_Update()
    if LP.Character and Vars.FFEnabled then
        for _, part in pairs(LP.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Material == Enum.Material.ForceField then
                part.Color = Vars.FFRainbow and Color3.fromHSV(tick() % 5 / 5, 1, 1) or Vars.FFColor
            end
        end
    end
end
local function FF_Remove(char)
    if ffOriginalColors[char] then
        for part, data in pairs(ffOriginalColors[char]) do
            if part and part.Parent and part:IsA("BasePart") then part.Color = data.Color; part.Material = data.Material end
        end
        ffOriginalColors[char] = {}
    end
end
local function FF_Toggle(value)
    Vars.FFEnabled = value
    if LP.Character then
        if value then
            FF_Apply(LP.Character)
            if ffConnection then ffConnection:Disconnect() end
            ffConnection = RunService.Heartbeat:Connect(FF_Update)
        else
            if ffConnection then ffConnection:Disconnect(); ffConnection = nil end
            FF_Remove(LP.Character)
        end
    end
end

local function Aura_LoadModel(id)
    local ok, r = pcall(function() return game:GetObjects(id)[1] end)
    return ok and r or nil
end
local function Aura_DisableOne(name)
    if activeClassicAuras[name] then
        for _, v in pairs(activeClassicAuras[name]) do if v and v.Parent then pcall(function() v:Destroy() end) end end
        activeClassicAuras[name] = nil
    end
end
local function Aura_EnableOne(char, name)
    if not char or not char.Parent then return end
    Aura_DisableOne(name)
    local id = AuraModelIDs[name]; if not id then return end
    local model = Aura_LoadModel(id); if not model then return end
    local effects = {}
    for _, obj in pairs(model:GetDescendants()) do
        if not obj:IsA('BasePart') then
            pcall(function()
                local clone = obj:Clone()
                local parentName = obj.Parent and obj.Parent.Name
                local target = char:FindFirstChild(parentName) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA('BasePart')
                if target then clone.Parent = target; table.insert(effects, clone) end
            end)
        end
    end
    pcall(function() model:Destroy() end)
    if #effects > 0 then activeClassicAuras[name] = effects end
end
function Aura_RefreshAll()
    local char = LP.Character; if not char then return end
    for _, name in ipairs(AuraModels) do Aura_DisableOne(name) end
    if not Vars.ClassicAuraEnabled then return end
    if type(Vars.ClassicAuraList) == "table" then
        for name, sel in pairs(Vars.ClassicAuraList) do
            if sel then task.spawn(function() Aura_EnableOne(char, name) end) end
        end
    end
end

local function MapParts(char)
    local parts = {}
    for _, c in ipairs(char:GetChildren()) do if c:IsA("BasePart") then parts[c.Name] = c end end
    return parts
end
local function GetParticleTemplate(name)
    if loadedParticleAuras[name] then return loadedParticleAuras[name] end
    local id = particleAuraIdByName[name]; if not id then return nil end
    local ok, r = pcall(function() return game:GetObjects(id)[1] end)
    if ok and r then loadedParticleAuras[name] = r; return r end
    return nil
end
local function TintSubtree(root, color)
    if not color or not root then return end
    local seq = ColorSequence.new(color)
    local function t(o) pcall(function()
        if o:IsA("ParticleEmitter") or o:IsA("Beam") or o:IsA("Trail") then o.Color = seq
        elseif o:IsA("PointLight") then o.Color = color end
    end) end
    t(root); for _, d in ipairs(root:GetDescendants()) do t(d) end
end
local function ApplyParticleAura(char, name, color)
    local tmpl = GetParticleTemplate(name); if not tmpl then return {} end
    local localParts = MapParts(char); local cloned = tmpl:Clone(); local created = {}
    for _, part in ipairs(cloned:GetChildren()) do
        local target = localParts[part.Name]
        if target then
            for _, child in ipairs(part:GetChildren()) do
                pcall(function()
                    local inst = child:Clone(); inst.Name = "SigmaParticleAura"; inst.Parent = target
                    if color then TintSubtree(inst, color) end
                    if inst:IsA("ParticleEmitter") then inst.Enabled = true end
                    for _, d in ipairs(inst:GetDescendants()) do
                        if d:IsA("ParticleEmitter") then d.Enabled = true end
                    end
                    table.insert(created, inst)
                end)
            end
        end
    end
    pcall(function() cloned:Destroy() end)
    return created
end
local function PA_DisableOne(name)
    if activeParticleAuras[name] then
        for _, p in ipairs(activeParticleAuras[name]) do if p then pcall(function() p:Destroy() end) end end
        activeParticleAuras[name] = nil
    end
end
function PA_RefreshAll()
    local char = LP.Character; if not char then return end
    for _, name in ipairs(PARTICLE_AURA_NAMES) do PA_DisableOne(name) end
    if not Vars.ParticleAuraEnabled then return end
    if type(Vars.ParticleAuraList) == "table" then
        for name, sel in pairs(Vars.ParticleAuraList) do
            if sel then
                task.spawn(function()
                    local p = ApplyParticleAura(char, name, Vars.ParticleAuraColor)
                    activeParticleAuras[name] = p
                end)
            end
        end
    end
end

