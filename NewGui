        function G:AddToggle(key, o)
            o = o or {}
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = 1
            row.LayoutOrder = self:_next()
            row.Parent = self.Body
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -50, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = WHITE
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = o.Text or key
            lbl.Parent = row
            local sw = Instance.new("Frame")
            sw.Size = UDim2.fromOffset(32, 16)
            sw.Position = UDim2.new(1, -32, 0.5, -8)
            sw.BackgroundColor3 = ITEM
            sw.BorderSizePixel = 0
            sw.Parent = row
            corner(sw, 8)
            stroke(sw)
            local dot = Instance.new("Frame")
            dot.Size = UDim2.fromOffset(12, 12)
            dot.Position = UDim2.fromOffset(2, 2)
            dot.BackgroundColor3 = MUTED
            dot.BorderSizePixel = 0
            dot.Parent = sw
            corner(dot, 6)
            local state = o.Default or false
            local extraCallbacks = {}
            local function update()
                TweenService:Create(dot, TweenInfo.new(0.15), {
                    Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
                    BackgroundColor3 = state and ACCENT or MUTED,
                }):Play()
                if o.Callback then pcall(o.Callback, state) end
                for _, cb in ipairs(extraCallbacks) do pcall(cb, state) end
            end
            local click = Instance.new("TextButton")
            click.Size = UDim2.fromScale(1, 1)
            click.BackgroundTransparency = 1
            click.Text = ""
            click.Parent = row
            click.MouseButton1Click:Connect(function()
                state = not state
                update()
            end)
            local api = {
                SetValue = function(v) state = v; update() end,
                GetValue = function() return state end,
                OnChanged = function(self, cb) table.insert(extraCallbacks, cb) end,
            }
            getgenv().Toggles = getgenv().Toggles or {}
            getgenv().Toggles[key] = api
            update()
            return api
        end

        function G:AddSlider(key, o)
            o = o or {}
            local minV = o.Min or 0
            local maxV = o.Max or 100
            local rounding = o.Rounding or 0
            local state = o.Default or minV

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 34)
            row.BackgroundTransparency = 1
            row.LayoutOrder = self:_next()
            row.Parent = self.Body

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -50, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = WHITE
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = o.Text or key
            lbl.Parent = row

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0, 50, 0, 16)
            valLbl.Position = UDim2.new(1, -50, 0, 0)
            valLbl.BackgroundTransparency = 1
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 12
            valLbl.TextColor3 = ACCENT
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = row

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 4)
            track.Position = UDim2.new(0, 0, 0, 22)
            track.BackgroundColor3 = ITEM
            track.BorderSizePixel = 0
            track.Parent = row
            corner(track, 2)
            stroke(track)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((state - minV) / (maxV - minV), 0, 1, 0)
            fill.BackgroundColor3 = ACCENT
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 2)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(10, 10)
            knob.Position = UDim2.new((state - minV) / (maxV - minV), -5, 0.5, -5)
            knob.BackgroundColor3 = WHITE
            knob.BorderSizePixel = 0
            knob.Parent = track
            corner(knob, 5)

            local function fmt(v)
                if rounding > 0 then return string.format("%." .. rounding .. "f", v) end
                return tostring(math.floor(v + 0.5))
            end
            valLbl.Text = fmt(state)

            local function setFromX(mx)
                local rel = math.clamp((mx - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                local v = minV + (maxV - minV) * rel
                if rounding > 0 then
                    local m = 10 ^ rounding
                    v = math.floor(v * m + 0.5) / m
                else
                    v = math.floor(v + 0.5)
                end
                if v ~= state then
                    state = v
                    local frac = (state - minV) / (maxV - minV)
                    fill.Size = UDim2.new(frac, 0, 1, 0)
                    knob.Position = UDim2.new(frac, -5, 0.5, -5)
                    valLbl.Text = fmt(state)
                    if o.Callback then pcall(o.Callback, state) end
                end
            end

            local dragging = false
            local hit = Instance.new("TextButton")
            hit.Size = UDim2.new(1, 0, 1, 20)
            hit.Position = UDim2.new(0, 0, 0, -10)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.Parent = row

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    setFromX(UIS:GetMouseLocation().X)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setFromX(UIS:GetMouseLocation().X)
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)

            return {
                SetValue = function(v)
                    state = math.clamp(v, minV, maxV)
                    local frac = (state - minV) / (maxV - minV)
                    fill.Size = UDim2.new(frac, 0, 1, 0)
                    knob.Position = UDim2.new(frac, -5, 0.5, -5)
                    valLbl.Text = fmt(state)
                    if o.Callback then pcall(o.Callback, state) end
                end,
                GetValue = function() return state end,
            }
        end

        function G:AddDropdown(key, o)
            o = o or {}
            local isMulti = o.Multi == true
            local values = o.Values or {}
            local state
            if isMulti then
                state = {}
                if type(o.Default) == "table" then
                    for k, v in pairs(o.Default) do if v then state[k] = true end end
                end
            else
                state = o.Default or (values[1] or "")
            end

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = 1
            row.LayoutOrder = self:_next()
            row.Parent = self.Body

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -130, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = WHITE
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = o.Text or key
            lbl.Parent = row

            local selBtn = Instance.new("TextButton")
            selBtn.Size = UDim2.new(0, 120, 1, -4)
            selBtn.Position = UDim2.new(1, -120, 0, 2)
            selBtn.BackgroundColor3 = ITEM
            selBtn.Font = Enum.Font.Gotham
            selBtn.TextSize = 11
            selBtn.TextColor3 = WHITE
            selBtn.TextTruncate = Enum.TextTruncate.AtEnd
            selBtn.Text = "None"
            selBtn.BorderSizePixel = 0
            selBtn.Parent = row
            corner(selBtn, 4)
            stroke(selBtn)

            local function getDisplay()
                if isMulti then
                    local c = 0
                    for _, v in pairs(state) do if v then c = c + 1 end end
                    if c == 0 then return "None" end
                    if c == 1 then for k in pairs(state) do return k end end
                    return c .. " selected"
                end
                return (state ~= "" and state) or "None"
            end
            local function refresh() selBtn.Text = getDisplay() end
            refresh()

            selBtn.MouseButton1Click:Connect(function()
                ClosePopup()
                local popup = Instance.new("Frame")
                local h = math.min(#values * 22 + 8, 300)
                popup.Size = UDim2.fromOffset(150, h)
                local pPos = selBtn.AbsolutePosition
                local pY = pPos.Y + selBtn.AbsoluteSize.Y + 4
                if pY + h > VPS.Y then pY = pPos.Y - h - 4 end
                popup.Position = UDim2.fromOffset(pPos.X + selBtn.AbsoluteSize.X - 150, pY)
                popup.BackgroundColor3 = ITEM
                popup.BorderSizePixel = 0
                popup.Parent = ScreenGui
                corner(popup, 6)
                stroke(popup)
                currentPopup = popup

                local scroll = Instance.new("ScrollingFrame")
                scroll.Size = UDim2.new(1, -8, 1, -8)
                scroll.Position = UDim2.fromOffset(4, 4)
                scroll.BackgroundTransparency = 1
                scroll.ScrollBarThickness = 2
                scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
                scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
                scroll.Parent = popup
                local layout = Instance.new("UIListLayout")
                layout.Padding = UDim.new(0, 2)
                layout.Parent = scroll

                local function rebuild()
                    for _, c in ipairs(scroll:GetChildren()) do
                        if c:IsA("TextButton") then pcall(function() c:Destroy() end) end
                    end
                    for i, val in ipairs(values) do
                        local isSel = (isMulti and state[val]) or (not isMulti and state == val)
                        local opt = Instance.new("TextButton")
                        opt.Size = UDim2.new(1, 0, 0, 20)
                        opt.BackgroundColor3 = isSel and ACCENT or ITEM
                        opt.Font = Enum.Font.Gotham
                        opt.TextSize = 11
                        opt.TextColor3 = WHITE
                        opt.TextXAlignment = Enum.TextXAlignment.Left
                        opt.Text = "  " .. tostring(val)
                        opt.BorderSizePixel = 0
                        opt.LayoutOrder = i
                        opt.Parent = scroll
                        corner(opt, 3)
                        opt.MouseButton1Click:Connect(function()
                            if isMulti then
                                if state[val] then state[val] = nil else state[val] = true end
                                refresh()
                                if o.Callback then pcall(o.Callback, state) end
                                rebuild()
                            else
                                state = val
                                refresh()
                                if o.Callback then pcall(o.Callback, state) end
                                ClosePopup()
                            end
                        end)
                    end
                end
                rebuild()

                local inside = false
                popup.MouseEnter:Connect(function() inside = true end)
                popup.MouseLeave:Connect(function() inside = false end)
                local conn
                conn = UIS.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and not inside and currentPopup == popup then
                        conn:Disconnect()
                        ClosePopup()
                    end
                end)
            end)

            return {
                SetValues = function(newValues)
                    values = newValues or {}
                    if isMulti then
                        local nState = {}
                        for k, v in pairs(state) do
                            if v then
                                for _, nv in ipairs(values) do
                                    if nv == k then nState[k] = true; break end
                                end
                            end
                        end
                        state = nState
                    else
                        local found = false
                        for _, v in ipairs(values) do
                            if v == state then found = true; break end
                        end
                        if not found then state = values[1] or "" end
                    end
                    refresh()
                    if o.Callback then pcall(o.Callback, state) end
                end,
                GetValue = function() return state end,
            }
        end

