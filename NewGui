local damageConns = {}
local function TrackDamageForPlayer(p)
    if p == LP then return end
    local function bind(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local prev = hum.Health
        if damageConns[hum] then pcall(function() damageConns[hum]:Disconnect() end) end
        damageConns[hum] = hum.HealthChanged:Connect(function(newH)
            if newH < prev - 0.01 then HandleDamage(char, char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")) end
            prev = newH
        end)
    end
    if p.Character then bind(p.Character) end
    p.CharacterAdded:Connect(bind)
end
for _, p in ipairs(Players:GetPlayers()) do TrackDamageForPlayer(p) end
