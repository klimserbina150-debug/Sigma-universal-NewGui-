        local extraCallbacks = {}

        local function update()
            TS:Create(tbg, TweenInfo.new(0.2), {
                BackgroundColor3 = state and WHITE or Color3.fromRGB(45,45,45)
            }):Play()
            TS:Create(dot, TweenInfo.new(0.2), {
