local ffOriginalColors, ffConnection = {}, nil
local function FF_Save(char)
    ffOriginalColors[char] = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then ffOriginalColors[char][part] = {Color = part.Color, Material = part.Material} end
    end
end
local function FF_Apply(char)
    FF_Save(char)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Color = Vars.FFColor; part.Material = Enum.Material.ForceField end
    end
end
local function FF_Update()
    if LP.Character and Vars.FFEnabled then
        for _, part in pairs(LP.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Material == Enum.Material.ForceField then
                part.Color = Vars.FFRainbow and Color3.fromHSV(tick()%5/5,1,1) or Vars.FFColor
            end
        end
    end
end
local function FF_Remove(char)
    if ffOriginalColors[char] then
        for part, data in pairs(ffOriginalColors[char]) do
            if part and part.Parent and part:IsA("BasePart") then part.Color = data.Color; part.Material = data.Material end
        end
        ffOriginalColors[char] = {}
    end
end
local function FF_Toggle(v)
    Vars.FFEnabled = v
    if LP.Character then
        if v then
            FF_Apply(LP.Character)
            if ffConnection then ffConnection:Disconnect() end
            ffConnection = RunService.Heartbeat:Connect(FF_Update)
        else
            if ffConnection then ffConnection:Disconnect(); ffConnection = nil end
            FF_Remove(LP.Character)
        end
    end
end

local function Aura_LoadModel(id)
    local ok, r = pcall(function() return game:GetObjects(id)[1] end)
    return ok and r or nil
end
local function Aura_DisableOne(name)
    if activeClassicAuras[name] then
        for _, v in pairs(activeClassicAuras[name]) do if v and v.Parent then pcall(function() v:Destroy() end) end end
        activeClassicAuras[name] = nil
    end
end
local function Aura_EnableOne(char, name)
    if not char or not char.Parent then return end
    Aura_DisableOne(name)
    local id = AuraModelIDs[name]; if not id then return end
    local model = Aura_LoadModel(id); if not model then return end
    local effects = {}
    for _, obj in pairs(model:GetDescendants()) do
        if not obj:IsA('BasePart') then
            pcall(function()
                local clone = obj:Clone()
                local pn = obj.Parent and obj.Parent.Name
                local target = char:FindFirstChild(pn) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA('BasePart')
                if target then clone.Parent = target; table.insert(effects, clone) end
            end)
        end
    end
    pcall(function() model:Destroy() end)
    if #effects > 0 then activeClassicAuras[name] = effects end
end
function Aura_RefreshAll()
    local char = LP.Character; if not char then return end
    for _, name in ipairs(AuraModels) do Aura_DisableOne(name) end
    if not Vars.ClassicAuraEnabled then return end
    if type(Vars.ClassicAuraList) == "table" then
        for name, sel in pairs(Vars.ClassicAuraList) do
            if sel then task.spawn(function() Aura_EnableOne(char, name) end) end
        end
