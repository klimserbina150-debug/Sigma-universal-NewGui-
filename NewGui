            end
        end
    end)
end)

local frozenHeadOriginal = {}
local function GetFrozenOriginal(char, head, hum)
    if frozenHeadOriginal[char] then return frozenHeadOriginal[char] end
    local data = {headSize = head.Size, meshScale = nil, headScale = nil}
    local mesh = head:FindFirstChildOfClass("SpecialMesh"); if mesh then data.meshScale = mesh.Scale end
    if hum then local hs = hum:FindFirstChild("HeadScale"); if hs and hs:IsA("NumberValue") then data.headScale = hs.Value end end
    frozenHeadOriginal[char] = data; return data
end
local function ApplyBigHead(char)
    if not char then return end
    local head = char:FindFirstChild("Head"); if not head or not head:IsA("BasePart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); local data = GetFrozenOriginal(char, head, hum)
    local scale = Vars.BigHeadScale
    local transp = Vars.BigHeadTransparency or 0
    local ts = data.headSize * scale
    if head.Size ~= ts then pcall(function() head.Size = ts end) end
    if head.Transparency ~= transp then pcall(function() head.Transparency = transp end) end
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if mesh and data.meshScale then
        local tm = data.meshScale * scale
        if mesh.Scale ~= tm then pcall(function() mesh.Scale = tm end) end
    end
    if hum then
        local hs = hum:FindFirstChild("HeadScale")
        if hs and hs:IsA("NumberValue") and data.headScale then
            local th = data.headScale * scale
            if hs.Value ~= th then pcall(function() hs.Value = th end) end
        end
    end
end
local function RestoreBigHead(char)
    if not char then return end
    local data = frozenHeadOriginal[char]; if not data then return end
    local head = char:FindFirstChild("Head"); local hum = char:FindFirstChildOfClass("Humanoid")
    if head and head:IsA("BasePart") then
        if head.Size ~= data.headSize then pcall(function() head.Size = data.headSize end) end
        pcall(function() head.Transparency = 0 end)
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh and data.meshScale and mesh.Scale ~= data.meshScale then pcall(function() mesh.Scale = data.meshScale end) end
    end
    if hum then local hs = hum:FindFirstChild("HeadScale"); if hs and hs:IsA("NumberValue") and data.headScale and hs.Value ~= data.headScale then pcall(function() hs.Value = data.headScale end) end end
    frozenHeadOriginal[char] = nil
end
local function IsTeammateBH(p)
    if not Vars.BigHeadTeamCheck then return false end
    if not p or not LP or not LP.Team or not p.Team then return false end
    return LP.Team == p.Team
end
local function BigHeadLoop()
    pcall(function()
        if not Vars.BigHeadEnabled then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= LP and p.Character then RestoreBigHead(p.Character) end end
            return
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                if IsTeammateBH(p) then RestoreBigHead(p.Character); continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then ApplyBigHead(p.Character) else RestoreBigHead(p.Character) end
            end
        end
    end)
end
RunService.RenderStepped:Connect(BigHeadLoop); RunService.Heartbeat:Connect(BigHeadLoop); RunService.Stepped:Connect(BigHeadLoop)
Players.PlayerRemoving:Connect(function(p) if p.Character then RestoreBigHead(p.Character) end end)

