RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Vars.TargetHUDEnabled or not currentAimTarget then thFrame.Visible = false; return end
        local ch = currentAimTarget; if not ch.Parent then thFrame.Visible = false; return end
        local hum = ch:FindFirstChild("Humanoid"); local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then thFrame.Visible = false; return end
        local now = tick(); if now - lastTargetHUD < 0.15 then return end; lastTargetHUD = now
        thFrame.Visible = true
        local pl = Players:GetPlayerFromCharacter(ch)
        if pl then
            thName.Text = pl.DisplayName
            pcall(function() thAvatar.Image = Players:GetUserThumbnailAsync(pl.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150) end)
            local held = GetWeapon(pl); thWeapon.Text = held ~= "none" and ("Holding: "..held) or ""
        else thName.Text = ch.Name; thAvatar.Image = ""; thWeapon.Text = "" end
        local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if mr then thDist.Text = "Distance: " .. string.format("%.1f", (mr.Position - hrp.Position).Magnitude) .. "m" end
        TweenService:Create(thHpFill, TweenInfo.new(0.15), { Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0) }):Play()
    end)
end)

