        if not Vars.AimbotEnabled then currentAimTarget = nil; return end
        if not Vars.AimbotAlways and not IsKeybindActive(Vars.AimbotKeybind) then currentAimTarget = nil; return end
        local t = GetClosestPlayer(); currentAimTarget = t
