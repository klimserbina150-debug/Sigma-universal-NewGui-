                        local m = UIS:GetMouseLocation()
                        local ap, as = sv.AbsolutePosition, sv.AbsoluteSize
                        s = math.clamp((m.X-ap.X)/math.max(as.X,1),0,1)
                        v = math.clamp(1-(m.Y-ap.Y)/math.max(as.Y,1),0,1)
                        apply()
                    end
                end)
                hue.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragHue = true
                        local m = UIS:GetMouseLocation()
                        local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
                        h = math.clamp((m.X-ap.X)/math.max(as.X,1),0,1)
                        apply()
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                    local m = UIS:GetMouseLocation()
                    if dragSV then
                        local ap, as = sv.AbsolutePosition, sv.AbsoluteSize
                        s = math.clamp((m.X-ap.X)/math.max(as.X,1),0,1)
                        v = math.clamp(1-(m.Y-ap.Y)/math.max(as.Y,1),0,1)
                        apply()
                    elseif dragHue then
                        local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
                        h = math.clamp((m.X-ap.X)/math.max(as.X,1),0,1)
                        apply()
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragSV, dragHue = false, false
                    end
                end)

                local inside = false
                popup.MouseEnter:Connect(function() inside = true end)
                popup.MouseLeave:Connect(function() inside = false end)
                local conn
                conn = UIS.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and not inside and currentPopup == popup then
                        conn:Disconnect()
                        ClosePopup()
                    end
                end)
            end)
        end

        function obj:AddKeyPicker(pkey, kOpts)
            kOpts = kOpts or {}
            local keyStr = kOpts.Default or "None"
            lbl.Size = UDim2.new(1,-65,1,0)

            local kb = Instance.new("TextButton", row)
            kb.Size = UDim2.fromOffset(60,18)
            kb.Position = UDim2.new(1,0,0.5,0)
            kb.AnchorPoint = Vector2.new(1,0.5)
            kb.BackgroundColor3 = Color3.fromRGB(30,30,30)
            kb.Text = "["..keyStr.."]"
            kb.TextColor3 = WHITE
            kb.Font = Enum.Font.Code
            kb.TextSize = 10
            kb.BorderSizePixel = 0
            Instance.new("UICorner", kb).CornerRadius = UDim.new(0,3)

            local waiting = false
            kb.MouseButton1Click:Connect(function()
                if waiting then return end
                waiting = true
                kb.Text = "[...]"
                local conn
                conn = UIS.InputBegan:Connect(function(input, gp)
                    if gp then return end
                    local set = nil
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then set = "MouseButton1"
                    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then set = "MouseButton2"
                    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then set = "MouseButton3"
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then set = input.KeyCode.Name end
                    if set then
                        keyStr = set
                        kb.Text = "["..set.."]"
                        waiting = false
                        conn:Disconnect()
                        if kOpts.Callback then pcall(kOpts.Callback, {Key = set}) end
                    end
                end)
            end)
        end

        return obj
    end

    function G:AddButton(text, cb)
        local btn = Instance.new("TextButton", g)
        btn.Size = UDim2.new(1,0,0,20)
        btn.BackgroundColor3 = Color3.fromRGB(25,25,25)
        btn.Text = text
        btn.TextColor3 = WHITE
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.BorderSizePixel = 0
        btn.LayoutOrder = nextOrder()
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0,3)
        btn.MouseButton1Click:Connect(function()
            if cb then pcall(cb) end
        end)
    end

    function G:AddDivider()
        local d = Instance.new("Frame", g)
        d.Size = UDim2.new(1,0,0,1)
        d.BackgroundColor3 = WHITE
        d.BackgroundTransparency = 0.9
        d.BorderSizePixel = 0
        d.LayoutOrder = nextOrder()
    end

    return G
end

function Library:CreateWindow(opts)
    local Win = {}

    function Win:AddTab(name)
        local btn = Instance.new("TextButton", tabsCont)
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 0
        btn.Text = string.upper(name)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 8
        btn.TextColor3 = MUTED
        btn.AutoButtonColor = false

        local underline = Instance.new("Frame", btn)
        underline.Size = UDim2.new(0.7,0,0,1)
        underline.Position = UDim2.new(0.15,0,1,-2)
        underline.BackgroundColor3 = WHITE
        underline.BorderSizePixel = 0
        underline.Visible = false

        local frame = Instance.new("Frame", content)
        frame.Size = UDim2.new(1,0,1,0)
        frame.BackgroundTransparency = 1
        frame.Visible = false

        local left = makeColumn(frame)
        left.Position = UDim2.fromOffset(0,0)
        local right = makeColumn(frame)
        right.Position = UDim2.new(0.5,0,0,0)

        tabs[name] = {frame=frame, left=left, right=right, button=btn, line=underline}
        table.insert(tabOrder, name)

        for _, n in ipairs(tabOrder) do
            tabs[n].button.Size = UDim2.new(1/#tabOrder, 0, 1, 0)
        end

        btn.MouseButton1Click:Connect(function()
            for n, data in pairs(tabs) do
                data.frame.Visible = (n == name)
                data.button.TextColor3 = (n == name) and WHITE or MUTED
                data.line.Visible = (n == name)
            end
        end)

        if #tabOrder == 1 then
            frame.Visible = true
            btn.TextColor3 = WHITE
            underline.Visible = true
        end

        local Tab = {}
        function Tab:AddLeftGroupbox(t) return makeGroupbox(left, t) end
        function Tab:AddRightGroupbox(t) return makeGroupbox(right, t) end
        return Tab
    end

    return Win
end

