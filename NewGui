local function IsGunTool(t)
    if not t then return false end
    local n = string.lower(t.Name)
    for _, kw in ipairs(MeleeKeywords) do if string.find(n, kw, 1, true) then return false end end
    for _, kw in ipairs(GunKeywords) do if string.find(n, kw, 1, true) then return true end end
    if t:FindFirstChild("Muzzle") or t:FindFirstChild("Barrel") or t:FindFirstChild("Scope") or t:FindFirstChild("Magazine") then return true end
    for _, d in ipairs(t:GetDescendants()) do
        if d:IsA("Sound") then
            local sn = string.lower(d.Name)
            if string.find(sn,"fire",1,true) or string.find(sn,"shoot",1,true) or string.find(sn,"gun",1,true) or string.find(sn,"shot",1,true) then return true end
        end
    end
    return false
end

